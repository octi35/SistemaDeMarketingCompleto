# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LinkedIn API Integration Credentials
# Get keys at: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_REDIRECT_URI="https://your-app-domain.run.app/api/linkedin/callback"
LINKEDIN_ACCESS_TOKEN="YOUR_LINKEDIN_ACCESS_TOKEN"

# Meta Developer API Integration Credentials (for Facebook/Instagram Publishing and Meta Ads Manager)
# Get keys at: https://developers.facebook.com/apps/
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_REDIRECT_URI="https://your-app-domain.run.app/api/meta/callback"
META_CLIENT_ID="YOUR_META_CLIENT_ID"
META_CLIENT_SECRET="YOUR_META_CLIENT_SECRET"
META_ACCESS_TOKEN="YOUR_META_ACCESS_TOKEN"
META_AD_ACCOUNT_ID="act_YOUR_META_AD_ACCOUNT_ID"

# Anthropic Claude API Integration Credentials (for Claude Haiku generation option)
# Get keys at: https://console.anthropic.com/
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# Access password for deployed instances (min 6 chars). With this set, the
# whole app + API require login (30-day session cookie). Leave empty in
# local dev to skip the lock screen. RECOMMENDED for any public deploy.
APP_PASSWORD=""

# Encryption key material for tokens at rest (and session signing). Set a
# long random string in production so scheduled-post tokens survive redeploys.
APP_SECRET=""

# Supabase (optional): durable cloud persistence + image storage.
# 1. Run supabase/migration.sql once in your project's SQL Editor.
# 2. Set these two vars (service_role key: Dashboard -> Settings -> API).
# Without them the app stores everything locally in .data/ as before.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# External API keys (comma-separated, 16+ chars each) to let OTHER systems
# call this app: POST /api/ext/publish-all, GET /api/ext/metrics, etc.
# Leave empty to keep the external API disabled. See API.md.
EXTERNAL_API_KEYS=""

# SMTP credentials for real email sending (Nodemailer). For Gmail use an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"

